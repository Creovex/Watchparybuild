# Copy to apps/web/.env.local (web app) and apps/extension/.env.local (sync extension).
# Never commit real values. Secrets marked "secret" go only into Supabase Edge Function secrets.

# Display name of the app. The product name is not decided yet (gap G16).
NEXT_PUBLIC_APP_NAME=Watchparty

# Public address of the web app, without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project address and anon key. Locally, `pnpm exec supabase status` prints both.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma separated sync extension ids allowed to talk to the web app (Chrome, Edge).
NEXT_PUBLIC_EXTENSION_IDS=

# LiveKit server address (wss://...). Used by Edge Functions and by the web app's CSP header.
LIVEKIT_URL=

# Secret: Edge Function secrets only (supabase secrets set ...).
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=

# Edge Function secrets for CORS (Cross Origin Resource Sharing): the site, the fixed preview
# domain and the extension origins (chrome-extension://<id>, comma separated).
SITE_URL=http://localhost:3000
PREVIEW_URL=
EXTENSION_ORIGINS=

# Local stack only. When set, turn-credentials returns STUN servers and no TURN.
# TURN_TEST_MODE=1

# Local stack only: an email and password form on the start page, because Google is off locally.
# NEXT_PUBLIC_DEV_EMAIL_SIGNIN=1

# Local only, where the stack's edge runtime cannot start: where `pnpm fn:serve` listens.
# NEXT_PUBLIC_FUNCTIONS_URL=http://127.0.0.1:54331
